<Window x:Class="Discoscope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Discoscope.Desktop.Controls"
        xmlns:vm="clr-namespace:Discoscope.Desktop.ViewModels"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        Title="Discoscope — Analyse de l'espace disque" Icon="Assets/appicon.ico" Width="1200" Height="790"
        MinWidth="900" MinHeight="620" Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen" Language="fr-FR" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <Image DockPanel.Dock="Left" Source="Assets/appicon-128.png" Width="44" Height="44"
                   Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="DISCOSCOPE" FontWeight="Bold" FontSize="27" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Comprenez ce qui occupe votre disque." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Text="ANALYSE LOCALE · NETTOYAGE SUR CONFIRMATION" HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Lecteur à analyser" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" 
                              IsEnabled="{Binding CanSelectDrive}" MinHeight="36" Width="240" HorizontalAlignment="Left"
                              Background="#273448" Foreground="#10151F"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Analyser" Command="{Binding ScanCommand}"
                        Margin="18,18,0,0" MinWidth="118"/>
                <Button Grid.Column="2" Content="Annuler" Command="{Binding CancelCommand}"
                        Margin="10,18,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Espace occupé et libre du volume (mesures Windows)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding FreeLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Fichiers analysés" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding FilesLabel}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Taille logique analysée" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding SizeLabel}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Avertissements" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding IssuesLabel}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            </Grid>
        </StackPanel>
        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
            <TabControl Background="{StaticResource PanelBrush}">
                <TabItem Header="Vue d'ensemble">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Dossiers les plus volumineux" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" Background="#1A2230"
                                      Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                                      BorderThickness="0" GridLinesVisibility="None" RowHeight="32"
                                      CanUserAddRows="False" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dossier" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="95"/>
                                    <DataGridTextColumn Header="Fichiers" Binding="{Binding FileCount}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Carte des dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button Content="Retour" Command="{Binding NavigateBackCommand}"
                                        DockPanel.Dock="Right" Padding="10,3" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding MapPath}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding MapPath}"/>
                            </DockPanel>
                            <controls:TreemapView Grid.Row="2" Items="{Binding MapEntries}" DirectoryPath="{Binding MapPath}"
                                                  NavigateCommand="{Binding NavigateMapCommand}"/>
                            <TextBlock Grid.Row="2" Text="{Binding MapHint}" IsHitTestVisible="False" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Explorateur">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Retour" Command="{Binding NavigateBackCommand}" Padding="10,5" Margin="6,0,0,0"/>
                                <Button Content="Copier le chemin" Click="CopyExplorerPath" Padding="10,5" Margin="6,0,0,0"
                                        IsEnabled="{Binding HasItems, ElementName=ExplorerTree}"/>
                                <Button Content="Ouvrir l’emplacement" Click="OpenExplorerLocation" Padding="10,5" Margin="6,0,0,0"
                                        IsEnabled="{Binding HasItems, ElementName=ExplorerTree}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MapPath}" ToolTip="{Binding MapPath}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" MinWidth="140"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TreeView x:Name="ExplorerTree" ItemsSource="{Binding ExplorerRoots}" SelectedItemChanged="SelectExplorerDirectory"
                                      AutomationProperties.Name="Dossiers" Background="{StaticResource CanvasBrush}"
                                      Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="5"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Directory.Path}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PanelBrush}"/>
                            <DataGrid x:Name="ExplorerTable" Grid.Column="2" ItemsSource="{Binding ExplorerItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      AutomationProperties.Name="Contenu du dossier" SelectionMode="Single" SelectionUnit="FullRow"
                                      Background="#1A2230" Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                                      BorderThickness="0" GridLinesVisibility="None" RowHeight="30" CanUserAddRows="False"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      Sorting="SortExplorer" MouseDoubleClick="OpenExplorerDirectory" PreviewKeyDown="HandleExplorerKey">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Taille logique" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="125"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" SortMemberPath="Type" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ExplorerEmptyState" Grid.Column="2" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="Ce dossier est vide ou inaccessible."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=ExplorerTable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentDirectory}" Value="{x:Null}">
                                                <Setter Property="Text" Value="Analysez un lecteur pour afficher ses fichiers."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Espace Windows">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Où se trouve votre espace ?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="Inventaire réel issu de l’analyse du disque. Tailles logiques, pas des gains récupérables garantis. Aucune suppression automatique."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding StorageInsights}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                                  Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                  AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="180"/>
                                <DataGridTextColumn Header="Taille logique" Binding="{Binding Size}" Width="110"/>
                                <DataGridTextColumn Header="Précaution" Binding="{Binding Risk}" Width="95"/>
                                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="1.1*"/>
                                <DataGridTextColumn Header="Conseil" Binding="{Binding Guidance}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Nettoyage">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Nettoyage des temporaires utilisateur" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Fichiers du dossier temporaire utilisateur non modifiés depuis 7 jours. Aperçu limité à 500 fichiers. Déplacement vers la Corbeille uniquement après confirmation."/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Rechercher" Click="PreviewUserTempCleanup" Padding="12,6"/>
                            <Button Content="Déplacer la sélection vers la Corbeille" Click="RecycleUserTempCleanup" Padding="12,6" Margin="10,0,0,0"/>
                            <TextBlock x:Name="CleanupStatus" Text="Aucun aperçu" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid x:Name="CleanupFiles" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" CanUserAddRows="False" EnableRowVirtualization="True"
                                  Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                  AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="Octets" Binding="{Binding Bytes}" Width="110"/>
                                <DataGridTextColumn Header="Modification UTC" Binding="{Binding ModifiedUtc}" Width="185"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Fichiers volumineux">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Les 200 plus grands fichiers accessibles" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding LargestFiles}" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#1A2230" Foreground="White"
                          RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                          BorderThickness="0" GridLinesVisibility="None" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="100"/>
                        <DataGridTextColumn Header="Taille logique" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                    </Grid>
                </TabItem>
                <TabItem Header="Avertissements">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Chemins ignorés ou inaccessibles (2 000 premiers)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ScanIssues}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                                  Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                  AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="Raison" Binding="{Binding Message}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Système">
                    <TabControl Margin="8" Background="{StaticResource PanelBrush}">
                        <TabItem Header="Fichiers temporaires">
                            <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Emplacements temporaires — diagnostic uniquement" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding TemporaryEntries}" AutoGenerateColumns="False" IsReadOnly="True" Background="#1A2230" Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Emplacement" Binding="{Binding Name}" Width="190"/>
                        <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Taille logique" Binding="{Binding Size}" Width="120"/>
                        <DataGridTextColumn Header="Fichiers" Binding="{Binding Files}" Width="85"/>
                        <DataGridTextColumn Header="Ignorés" Binding="{Binding Skipped}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>

                            </Grid>
                        </TabItem>
                        <TabItem Header="Composants et clichés">
                                            <TabControl Margin="0,10,0,0" Background="#1A2230">
                    <TabItem Header="Composants Windows · DISM">
                        <DockPanel Background="#1A2230" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,7,0,7">
                                <Button Content="Analyser les composants" Command="{Binding AnalyzeWindowsCommand}"/>
                                <TextBlock Text="{Binding ComponentStatus}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Text="{Binding ComponentReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Background="#10151F" Foreground="#EFF4FC" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Clichés instantanés · VSS">
                        <DockPanel Background="#1A2230" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,7,0,7">
                                <Button Content="Analyser les clichés VSS" Command="{Binding AnalyzeVssCommand}"/>
                                <TextBlock Text="{Binding VssStatus}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Text="{Binding VssReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Background="#10151F" Foreground="#EFF4FC" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="7" Margin="0,10,0,0">
            <ProgressBar Height="3" Margin="0,0,0,5" IsIndeterminate="{Binding IsBusy}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Les fichiers système protégés, les liens NTFS et les clichés VSS nécessitent une analyse distincte. Aucune suppression n'est effectuée."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
