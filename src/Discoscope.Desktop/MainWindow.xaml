<Window x:Class="Discoscope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Discoscope.Desktop.Controls"
        xmlns:vm="clr-namespace:Discoscope.Desktop.ViewModels"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        Title="Discoscope — Analyse de l'espace disque" Icon="Assets/appicon.ico" Width="1200" Height="790"
        MinWidth="900" MinHeight="620" Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen" Language="fr-FR" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/appicon-128.png" Width="40" Height="40" Margin="0,0,11,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Discoscope" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Analyse de l’espace disque" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="_Analyser" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="100" AutomationProperties.Name="Analyser"/>
                    <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="Lecteur" x:Name="DriveLabel" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                              IsEnabled="{Binding CanSelectDrive}" MinHeight="32" Width="124"
                              AutomationProperties.LabeledBy="{Binding ElementName=DriveLabel}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Espace du volume" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding VolumeLabel}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding FreeLabel}" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Text="Fichiers analysés" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding FilesLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Text="Taille logique analysée" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding SizeLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock Text="Avertissements" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding IssuesLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="10">
            <TabControl Background="{StaticResource PanelBrush}" BorderThickness="0">
                <TabItem Header="Vue d'ensemble">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Dossiers les plus volumineux" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="OverviewTable" Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" Background="#1A2230"
                                      Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                                      BorderThickness="0" GridLinesVisibility="None" RowHeight="32"
                                      CanUserAddRows="False" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Dossier" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="95"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Fichiers" Binding="{Binding FileCount}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Style="{StaticResource EmptyTableHint}"
                                       Tag="{Binding ElementName=OverviewTable}" Text="Les dossiers les plus volumineux apparaîtront ici après l’analyse."/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Carte des dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button Content="Retour" Command="{Binding NavigateBackCommand}"
                                        DockPanel.Dock="Right" Padding="10,3" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding MapPath}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding MapPath}"/>
                            </DockPanel>
                            <controls:TreemapView Grid.Row="2" Items="{Binding MapEntries}" DirectoryPath="{Binding MapPath}"
                                                  NavigateCommand="{Binding NavigateMapCommand}"
                                                  AutomationProperties.Name="Carte des dossiers"/>
                            <TextBlock Grid.Row="2" Text="{Binding MapHint}" IsHitTestVisible="False" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <WrapPanel Grid.Row="3" Margin="0,7,0,0" TextElement.Foreground="{StaticResource MutedBrush}">
                                <Rectangle Width="9" Height="9" Fill="{x:Static controls:TreemapView.DirectoryBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Dossiers" Margin="0,0,10,0"/>
                                <Rectangle Width="9" Height="9" Fill="{x:Static controls:TreemapView.FileBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Fichiers" Margin="0,0,10,0"/>
                                <Rectangle Width="9" Height="9" Fill="{x:Static controls:TreemapView.OtherBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Autres" Margin="0,0,10,0"/>
                                <TextBlock Text="Flèches · Entrée" ToolTip="Choisir puis ouvrir un dossier sur la carte."/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Explorateur">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Retour" Command="{Binding NavigateBackCommand}" Padding="10,5" Margin="6,0,0,0"/>
                                <Button Content="Copier le chemin" Click="CopyExplorerPath" Padding="10,5" Margin="6,0,0,0"
                                        IsEnabled="{Binding HasItems, ElementName=ExplorerTree}"/>
                                <Button Content="Ouvrir l’emplacement" Click="OpenExplorerLocation" Padding="10,5" Margin="6,0,0,0"
                                        IsEnabled="{Binding HasItems, ElementName=ExplorerTree}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MapPath}" ToolTip="{Binding MapPath}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" MinWidth="140"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TreeView x:Name="ExplorerTree" ItemsSource="{Binding ExplorerRoots}" SelectedItemChanged="SelectExplorerDirectory"
                                      AutomationProperties.Name="Dossiers" Background="{StaticResource CanvasBrush}"
                                      Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="5"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Directory.Path}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PanelBrush}"/>
                            <DataGrid x:Name="ExplorerTable" Grid.Column="2" ItemsSource="{Binding ExplorerItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      AutomationProperties.Name="Contenu du dossier" SelectionMode="Single" SelectionUnit="FullRow"
                                      Background="#1A2230" Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                                      BorderThickness="0" GridLinesVisibility="None" RowHeight="30" CanUserAddRows="False"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      Sorting="SortExplorer" MouseDoubleClick="OpenExplorerDirectory" PreviewKeyDown="HandleExplorerKey">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Nom" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille logique" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="125"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Type" Binding="{Binding Type}" SortMemberPath="Type" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ExplorerEmptyState" Grid.Column="2" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="Ce dossier est vide ou inaccessible."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=ExplorerTable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentDirectory}" Value="{x:Null}">
                                                <Setter Property="Text" Value="Analysez un lecteur pour afficher ses fichiers."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Espace Windows">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Où se trouve votre espace ?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="Inventaire réel issu de l’analyse du disque. Tailles logiques, pas des gains récupérables garantis. Aucune suppression automatique."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <DataGrid x:Name="StorageTable" Grid.Row="2" ItemsSource="{Binding StorageInsights}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                                  Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                  AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Catégorie" Binding="{Binding Category}" Width="180"/>
                                <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille logique" Binding="{Binding Size}" Width="110"/>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Précaution" Binding="{Binding Risk}" Width="95"/>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Chemin" Binding="{Binding Path}" Width="1.1*"/>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Conseil" Binding="{Binding Guidance}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Style="{StaticResource EmptyTableHint}" Tag="{Binding ElementName=StorageTable}"
                                   Text="L’inventaire de l’espace Windows apparaît après l’analyse."/>
                    </Grid>
                </TabItem>
                <TabItem Header="Nettoyage">
                    <ScrollViewer x:Name="CleanupViewport" Margin="8" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid MinHeight="300" TextElement.Foreground="{StaticResource TextBrush}"
                              Height="{Binding ViewportHeight, ElementName=CleanupViewport}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Nettoyage des fichiers temporaires" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Margin="0,5,0,7" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="Fichiers non modifiés depuis au moins 7 jours. Envoi à la Corbeille après confirmation."/>
                            <WrapPanel Grid.Row="2" Margin="0,0,0,7">
                                <ComboBox x:Name="CleanupLocation" Width="185" SelectedIndex="0" SelectionChanged="CleanupLocationChanged" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <ComboBoxItem Content="Temporaires utilisateur"/>
                                    <ComboBoxItem Content="Temporaires Windows"/>
                                </ComboBox>
                                <Button x:Name="CleanupPreviewButton" Style="{StaticResource PrimaryButton}" Content="Rechercher" Click="PreviewUserTempCleanup" Padding="9,6"/>
                                <Button x:Name="CleanupSelectAllButton" Content="Toute la page" AutomationProperties.Name="Sélectionner la page" Click="SelectAllCleanupFiles" Padding="9,6" Margin="10,0,0,0" IsEnabled="False"/>
                                <Button x:Name="CleanupCancelButton" Content="Annuler" Click="CancelCleanup" Padding="9,6" Margin="10,0,0,0" IsEnabled="False"/>
                                <Button x:Name="CleanupRecycleAllButton" Style="{StaticResource CleanupButton}" Content="Tout déplacer" AutomationProperties.Name="Déplacer toutes les pages vers la Corbeille" Click="RecycleAllCleanup" Padding="9,6" Margin="10,0,0,0" IsEnabled="False"/>
                                <Button x:Name="CleanupRecycleButton" Style="{StaticResource CleanupButton}" Content="Déplacer la sélection" AutomationProperties.Name="Déplacer la sélection vers la Corbeille" Click="RecycleUserTempCleanup" Padding="9,6" Margin="10,0,0,0" IsEnabled="False"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,4">
                                <DockPanel Margin="0,0,0,4">
                                    <Button x:Name="CleanupPreviousPage" Content="Précédent" Click="PreviousCleanupPage"
                                            IsEnabled="False" Padding="12,5"/>
                                    <TextBlock x:Name="CleanupPageStatus" Text="Aucune page" Margin="12,0" VerticalAlignment="Center"/>
                                    <Button x:Name="CleanupNextPage" Content="Suivant" Click="NextCleanupPage"
                                            IsEnabled="False" Padding="12,5"/>
                                    <TextBlock x:Name="CleanupStatus" Text="Aucun aperçu" Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>
                                <ProgressBar x:Name="CleanupProgressBar" Height="3" Visibility="Hidden"
                                             Foreground="{StaticResource AccentBrush}"
                                             AutomationProperties.Name="Progression du nettoyage"/>
                            </StackPanel>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="295"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid x:Name="CleanupFiles" AutoGenerateColumns="False" IsReadOnly="True"
                                          AutomationProperties.Name="Fichiers temporaires éligibles" SelectionMode="Extended"
                                          SelectionChanged="CleanupSelectionChanged" CanUserAddRows="False" EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                          AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CleanupFileName}" Header="Fichier" Binding="{Binding Name}" Width="*" MinWidth="145"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Octets" Binding="{Binding Bytes}" Width="65"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Modification UTC" Binding="{Binding ModifiedUtc}" Width="145"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Grid.Column="2">
                                    <Button DockPanel.Dock="Top" x:Name="CleanupOverviewButton" Content="Évaluer les deux emplacements"
                                            Click="PreviewCleanupOverview" HorizontalAlignment="Left" Padding="12,5"/>
                                    <TextBlock DockPanel.Dock="Top" x:Name="CleanupOverviewStatus" Margin="0,5,0,3"
                                               Text="Évaluation séparée des fichiers éligibles." TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <DataGrid x:Name="CleanupCategories" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                              AutomationProperties.Name="Catégories de fichiers temporaires"
                                              SelectionMode="Single" SelectionChanged="CleanupCategorySelected" CanUserAddRows="False"
                                              Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                              AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Emplacement" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Fichiers" Binding="{Binding Count, TargetNullValue=—}" Width="65"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille" Binding="{Binding Size}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Fichiers volumineux">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Les 200 plus grands fichiers accessibles" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <DataGrid x:Name="LargestFilesTable" Grid.Row="1" ItemsSource="{Binding LargestFiles}" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#1A2230" Foreground="White"
                          RowBackground="#1A2230" AlternatingRowBackground="#222C3D"
                          BorderThickness="0" GridLinesVisibility="None" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Fichier" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Type" Binding="{Binding Extension}" Width="100"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille logique" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                                        <TextBlock Grid.Row="1" Style="{StaticResource EmptyTableHint}"
                                                   Tag="{Binding ElementName=LargestFilesTable}" Text="Aucun fichier volumineux à afficher."/>

                    </Grid>
                </TabItem>
                <TabItem Header="Avertissements">
                    <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Chemins ignorés ou inaccessibles (2 000 premiers)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="ScanIssuesTable" Grid.Row="1" ItemsSource="{Binding ScanIssues}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                                  Background="#1A2230" Foreground="White" RowBackground="#1A2230"
                                  AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Chemin" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Raison" Binding="{Binding Message}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EmptyTableHint}"
                                   Tag="{Binding ElementName=ScanIssuesTable}" Text="Aucun avertissement à afficher."/>
                    </Grid>
                </TabItem>
                <TabItem Header="Système">
                    <TabControl Margin="8" Background="{StaticResource PanelBrush}">
                        <TabItem Header="Fichiers temporaires">
                            <Grid Margin="8" TextElement.Foreground="{StaticResource TextBrush}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Emplacements temporaires — diagnostic uniquement" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                <DataGrid x:Name="TemporaryTable" Grid.Row="1" ItemsSource="{Binding TemporaryEntries}" AutoGenerateColumns="False" IsReadOnly="True" Background="#1A2230" Foreground="White" RowBackground="#1A2230" AlternatingRowBackground="#222C3D" BorderThickness="0" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Emplacement" Binding="{Binding Name}" Width="190"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Chemin" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Taille logique" Binding="{Binding Size}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Fichiers" Binding="{Binding Files}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TableNumber}" Header="Ignorés" Binding="{Binding Skipped}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                                                <TextBlock Grid.Row="1" Style="{StaticResource EmptyTableHint}"
                                                           Tag="{Binding ElementName=TemporaryTable}" Text="L’inventaire des emplacements temporaires apparaît après l’analyse."/>

                            </Grid>
                        </TabItem>
                        <TabItem Header="Composants et clichés">
                                            <TabControl Margin="0,10,0,0" Background="#1A2230">
                    <TabItem Header="Composants Windows · DISM">
                        <DockPanel Background="#1A2230" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,7,0,7">
                                <Button Content="Analyser les composants" Command="{Binding AnalyzeWindowsCommand}" Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="{Binding ComponentStatus}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Text="{Binding ComponentReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Background="#10151F" Foreground="#EFF4FC" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Clichés instantanés · VSS">
                        <DockPanel Background="#1A2230" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,7,0,7">
                                <Button Content="Analyser les clichés VSS" Command="{Binding AnalyzeVssCommand}" Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="{Binding VssStatus}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Text="{Binding VssReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Background="#10151F" Foreground="#EFF4FC" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar Height="3" Margin="0,0,0,5" Foreground="{StaticResource AccentBrush}"
                         IsIndeterminate="{Binding IsBusy}" AutomationProperties.Name="Progression de l’analyse">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
